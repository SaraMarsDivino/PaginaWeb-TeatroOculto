---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { equipo } from '@/data/equipo';
---

<BaseLayout
  title="Nosotros — Teatro Oculto"
  description="Conoce al equipo detrás de Teatro Oculto, compañía de artes escénicas en La Calera, Valparaíso."
>
  <Navbar slot="navbar" />

  <!-- Page hero -->
  <section class="section pt-16 pb-20" aria-label="Sobre nosotros">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <!-- Text -->
      <div>
        <p class="section-title">Quiénes somos</p>
        <h1 class="section-heading mb-6">Sobre<br/>nosotros</h1>
        <div class="gold-bar"></div>

        <div class="mt-8 space-y-5 text-sm text-white/82 leading-relaxed">
          <p>
            Teatro Oculto es una organización con sede en la comuna de La Calera, Región de Valparaíso,
            dedicada a la promoción, fortalecimiento y difusión de las artes escénicas. Nace con el
            propósito de abrir caminos para el desarrollo teatral en territorios descentralizados, desde
            la convicción de que la descentralización no consiste solo en distribuir, sino en crear
            desde los propios territorios.
          </p>
          <p>
            Somos artistas escénicos de la región interior, movilizados por el encuentro entre arte y
            comunidad. Entendemos el teatro como una herramienta reflexiva, expresiva y transformadora,
            capaz de aportar al desarrollo integral de un territorio y de quienes lo habitan.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- Misión -->
          <div class="card-glass p-6">
            <div
              class="w-9 h-9 rounded-lg flex items-center justify-center mb-4"
              style="background: rgba(224,66,66,0.12); border: 1px solid rgba(224,66,66,0.2);"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-crimson">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
                <path d="M12 2v2M12 20v2M2 12h2M20 12h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="text-sm font-black uppercase tracking-widest text-white mb-2">Misión</h3>
            <p class="text-xs text-white/75 leading-relaxed">
              Desarrollar experiencias escénicas significativas que contribuyan a la descentralización
              de la cultura, fortaleciendo el encuentro, la reflexión y la construcción de comunidad.
            </p>
          </div>

          <!-- Visión -->
          <div class="card-glass p-6">
            <div
              class="w-9 h-9 rounded-lg flex items-center justify-center mb-4"
              style="background: rgba(215,179,106,0.10); border: 1px solid rgba(215,179,106,0.2);"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="color: #d7b36a;">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </div>
            <h3 class="text-sm font-black uppercase tracking-widest text-white mb-2">Visión</h3>
            <p class="text-xs text-white/75 leading-relaxed">
              Ser una organización referente en el fortalecimiento de las artes escénicas, impulsando
              la creación artística y la descentralización cultural con impacto social sostenible.
            </p>
          </div>
        </div>
      </div>

      <!-- Image -->
      <div class="relative">
        <div class="card-glass overflow-hidden rounded-3xl" style="height: 540px;">
          <img
            src="/images/brand/ensayo-oculto.jpg"
            srcset="/images/brand/thumbs/ensayo-oculto.jpg 640w, /images/brand/ensayo-oculto.jpg 1400w"
            sizes="(max-width: 1024px) 100vw, 45vw"
            alt="Ensayo de Teatro Oculto"
            class="w-full h-full object-cover"
            style="height: 540px; filter: contrast(1.08) saturate(1.02);"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div
            class="absolute inset-0 pointer-events-none rounded-3xl"
            style="background: linear-gradient(to top, rgba(6,8,16,0.6) 0%, transparent 40%);"
          ></div>
        </div>

        <!-- Floating badge -->
        <div
          class="absolute -bottom-5 -left-5 px-5 py-4 rounded-2xl border border-white/08 hidden lg:block"
          style="background: rgba(6,8,16,0.92); backdrop-filter: blur(16px);"
        >
          <p class="text-xs font-black uppercase tracking-theater text-white/40 mb-0.5">Sede</p>
          <p class="text-sm font-bold text-white">La Calera, Valparaíso</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipo -->
  <section class="section py-24 border-t border-white/04" aria-label="Equipo">
    <div class="mb-12">
      <p class="section-title">Las personas</p>
      <h2 class="section-heading">Equipo ejecutivo</h2>
      <div class="gold-bar"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {equipo.map((member) => (
        <article class="card-glass p-6 group">
          <div class="flex items-start gap-5">
            <!-- Photo: B&W → color on hover -->
            <div class="flex-shrink-0 overflow-hidden rounded-2xl w-20 h-20">
              <img
                src={member.photo}
                alt={member.name}
                class="w-full h-full object-cover transition-all duration-500"
                style="filter: grayscale(1) contrast(1.05);"
                loading="lazy"
                decoding="async"
                width="80"
                height="80"
                onerror="this.onerror=null;this.style.background='rgba(255,255,255,0.05)';"
                onmouseover="this.style.filter='grayscale(0) contrast(1.02)'"
                onmouseout="this.style.filter='grayscale(1) contrast(1.05)'"
              />
            </div>

            <div class="min-w-0 flex-1">
              <h3 class="text-base font-bold text-white leading-tight mb-0.5">{member.name}</h3>
              <p class="text-xs text-white/40 font-bold uppercase tracking-widest mb-3">{member.role}</p>

              <div class="flex flex-wrap gap-1.5 mb-3">
                {member.credentials.map((cred) => (
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/04 border border-white/08 text-white/70">
                    {cred}
                  </span>
                ))}
              </div>

              <p class="text-xs text-white/75 leading-relaxed">{member.bio}</p>

              {member.bioExtended && (
                <details class="mt-3">
                  <summary class="text-xs font-bold uppercase tracking-widest text-crimson cursor-pointer hover:text-crimson-hover transition-colors list-none flex items-center gap-1">
                    Leer más
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" class="transition-transform details-arrow">
                      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <p class="mt-2 text-xs text-white/65 leading-relaxed">{member.bioExtended}</p>
                </details>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  details[open] .details-arrow {
    transform: rotate(180deg);
  }
  details summary::-webkit-details-marker { display: none; }
</style>

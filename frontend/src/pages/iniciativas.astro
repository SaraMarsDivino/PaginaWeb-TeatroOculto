---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { getCollection } from 'astro:content';

const iniciativas = await getCollection('iniciativas');
const sorted = iniciativas.sort((a, b) => a.data.order - b.data.order);
const visibleIniciativas = sorted.filter((ini) => ini.slug !== 'conocer-a-nuestros-publicos');

// Render markdown body for each (Astro 4: entry.render())
const rendered = await Promise.all(
  visibleIniciativas.map(async (ini) => {
    const { Content } = await ini.render();
    return { ini, Content };
  })
);

const ejeIcons: Record<string, string> = {
  Creación: `<path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="1.4" fill="none"/>`,
  Formación: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.4"/>`,
  Comunidad: `<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.4"/><path d="M8 12s1.5-2 4-2 4 2 4 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="9" y1="9" x2="9.01" y2="9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="15" y1="9" x2="15.01" y2="9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
};

const categoryColors: Record<string, string> = {
  Creación: 'rgba(224,66,66,0.14)',
  Formación: 'rgba(215,179,106,0.12)',
  Comunidad: 'rgba(99,179,237,0.12)',
};
---

<BaseLayout
  title="Iniciativas — Teatro Oculto"
  description="Conoce los ejes de trabajo de Teatro Oculto: Creación, Formación de audiencias y Colaboración comunitaria."
>
  <Navbar slot="navbar" />

  <!-- Page hero -->
  <section class="section pt-16 pb-12">
    <p class="section-title">Lo que hacemos</p>
    <h1 class="section-heading mb-3">Ejes de trabajo</h1>
    <div class="gold-bar"></div>
    <p class="mt-5 text-sm text-white/75 max-w-lg leading-relaxed">
      Nuestro trabajo se articula en tres ejes complementarios que buscan fortalecer las artes escénicas
      desde la creación, la formación y la comunidad.
    </p>
  </section>

  <!-- Ejes cards -->
  <section class="section pt-0 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      {rendered.map(({ ini, Content }) => (
        <details
          class="card-glass overflow-hidden ini-details group"
          id={`eje-${ini.slug}`}
        >
          <summary class="cursor-pointer list-none">
            <!-- Card image -->
            <div class="ini-media relative overflow-hidden" style="height: 260px;">
              <img
                src={ini.data.image}
                alt={ini.data.title}
                class="w-full h-full object-contain transition-transform duration-300"
                style="height: 260px;"
                loading="lazy"
                decoding="async"
                onerror="this.onerror=null;this.src='/images/placeholder-photo.svg';"
              />
              <div class="absolute inset-0 pointer-events-none transition-opacity duration-200 ini-hover-overlay"
                style="background: rgba(0,0,0,0.35); display:flex; align-items:center; justify-content:center; opacity:0;">
                <span class="text-xs font-black uppercase tracking-theater text-white border border-white/30 px-3 py-1.5 rounded-full">
                  Leer más
                </span>
              </div>
            </div>

            <!-- Card header -->
            <div class="p-6 pb-4">
              <!-- Icon -->
              <div
                class="w-10 h-10 rounded-xl flex items-center justify-center mb-4"
                style={`background: ${categoryColors[ini.data.category] ?? 'rgba(255,255,255,0.06)'}; border: 1px solid rgba(255,255,255,0.08);`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-white/70">
                  <Fragment set:html={ejeIcons[ini.data.category] ?? ''} />
                </svg>
              </div>

              <span class="text-[10px] font-black uppercase tracking-theater text-white/35 block mb-1">
                {ini.data.category}
              </span>
              <h2 class="text-lg font-bold text-white">{ini.data.title}</h2>
            </div>
          </summary>

          <!-- Expandable body -->
          <div class="ini-body-wrap">
            <div class="ini-body px-6 pb-6 text-sm text-white/80 leading-relaxed">
              <div class="h-px w-full bg-white/06 mb-5"></div>
              <div class="prose prose-invert prose-sm max-w-none">
                <Content />
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- Sección: Conocer a nuestros públicos -->
  <section class="max-w-6xl mx-auto mt-20 border-t border-white/10 pt-16 pb-6">
    <div class="px-4 md:px-0">
      <h2 class="text-3xl md:text-4xl font-black uppercase tracking-theater text-white/90">
        CONOCER A NUESTROS PÚBLICOS
      </h2>

      <h3 class="mt-4 text-xl md:text-2xl font-bold text-white/90">
        Lo que aprendimos de ¡Viva el Teatro! 2026
      </h3>

      <div class="mt-6 max-w-4xl space-y-5 text-base md:text-lg text-white/80 leading-relaxed">
        <p>
          En agosto de 2026, Teatro Oculto desarrolló ¡Viva el Teatro!, iniciativa de exhibición y formación de públicos realizada en el recientemente inaugurado Centro Cultural de La Calera.
        </p>
        <p>
          La iniciativa contempló funciones para comunidades educativas y público general, junto con un plan de difusión multicanal que incluyó intervenciones teatrales en 8 establecimientos educacionales de La Calera, difusión digital y articulación con instituciones y agentes del territorio.
        </p>
        <p>
          Como parte de esta experiencia, incorporamos herramientas de estudio de públicos mediante el formulario de reserva de entradas y una encuesta posfunción aplicada a asistentes de la función abierta a la comunidad. Este levantamiento nos permitió generar una primera línea de información sobre quiénes participan, cómo llegan al teatro y cómo se vinculan con la experiencia escénica.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
        <article class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <p class="text-4xl md:text-5xl font-black leading-none text-[#e04242]">14,6%</p>
          <h4 class="mt-4 text-xl font-bold text-white/90">Públicos no frecuentes</h4>
          <p class="mt-3 text-base text-white/80 leading-relaxed">
            El 14,6% de las personas encuestadas declaró no asistir habitualmente al teatro, evidenciando la participación de públicos con distintos niveles de vinculación previa con las artes escénicas.
          </p>
        </article>

        <article class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <p class="text-4xl md:text-5xl font-black leading-none text-[#e04242]">82,9%</p>
          <h4 class="mt-4 text-xl font-bold text-white/90">Asistencia acompañada</h4>
          <p class="mt-3 text-base text-white/80 leading-relaxed">
            El 82,9% de las reservas correspondió a solicitudes de dos o tres entradas, mostrando una marcada tendencia a vivir el teatro como una experiencia compartida.
          </p>
        </article>

        <article class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <p class="text-4xl md:text-5xl font-black leading-none text-[#e04242]">≈39%</p>
          <h4 class="mt-4 text-xl font-bold text-white/90">El vínculo moviliza</h4>
          <p class="mt-3 text-base text-white/80 leading-relaxed">
            Aproximadamente el 39% de las reservas se originó mediante alguna forma de vínculo interpersonal —invitación directa, amistades, personas conocidas o estudiantes—, destacando la importancia de las redes y relaciones comunitarias en la circulación cultural.
          </p>
        </article>

        <article class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <p class="text-4xl md:text-5xl font-black leading-none text-[#e04242]">69,1% / 30,9%</p>
          <h4 class="mt-4 text-xl font-bold text-white/90">Anclaje local y participación intercomunal</h4>
          <p class="mt-3 text-base text-white/80 leading-relaxed">
            El 69,1% de las personas encuestadas provenía de La Calera, mientras que el 30,9% correspondía a Hijuelas, La Cruz, Quillota y El Melón. Los resultados evidencian un fuerte anclaje local junto con una participación inicial de públicos provenientes de territorios cercanos.
          </p>
        </article>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-4">
        <img
          src="/images/iniciativas/publico-1.jpg"
          alt="Públicos de Teatro Oculto"
          class="h-[280px] w-full rounded-2xl border border-white/10 object-cover"
          loading="lazy"
        />
        <img
          src="/images/iniciativas/publico-2.jpg"
          alt="Encuesta de públicos de Teatro Oculto"
          class="h-[280px] w-full rounded-2xl border border-white/10 object-cover"
          loading="lazy"
        />
      </div>

      <div class="mt-14 overflow-hidden rounded-2xl border border-white/10 bg-black/20">
        <div class="aspect-video w-full">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/AhXuOfveFPE"
            title="Teatro Oculto - Conocer a nuestros públicos"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <div class="mt-16 max-w-4xl">
        <h3 class="text-2xl md:text-3xl font-black uppercase tracking-theater text-white/90">
          INVESTIGAR PARA SEGUIR CRECIENDO
        </h3>

        <p class="mt-5 text-base md:text-lg text-white/80 leading-relaxed">
          Esta experiencia constituye una primera línea base para el estudio y desarrollo de públicos de Teatro Oculto en el territorio, incorporando la observación y el análisis como herramientas para orientar futuras acciones de programación, mediación y vinculación territorial.
        </p>

        <p class="mt-6 text-sm text-white/40 leading-relaxed">
          Fuente: Estudio de Públicos ¡Viva el Teatro! 2026. Datos obtenidos mediante formulario de reserva de entradas (82 respuestas) y encuesta posfunción (55 respuestas), aplicada a asistentes de la función abierta a la comunidad de La Malattia di Nogasto, de Cía. Familia Nogasto, que registró una asistencia total de 159 personas. De manera complementaria, la obra contó con dos funciones dirigidas a establecimientos educacionales del DAEM de La Calera, alcanzando aproximadamente 400 estudiantes. La Calera, agosto de 2026.
        </p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .ini-details summary::-webkit-details-marker { display: none; }
  .ini-details:hover .ini-hover-overlay { opacity: 1 !important; }
  .ini-details:hover summary img { transform: scale(1.025); }

  .ini-body-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms ease;
  }
  .ini-body {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 260ms ease 80ms, transform 300ms ease 80ms;
  }
  details[open] .ini-body-wrap { grid-template-rows: 1fr; }
  details[open] .ini-body { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .ini-body-wrap, .ini-body { transition: none !important; }
  }
</style>

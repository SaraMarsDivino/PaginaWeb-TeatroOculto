DJANGO_SECRET_KEY=replace-me
DEBUG=0
ALLOWED_HOSTS=yourdomain.com

# Needed in production behind HTTPS (Nginx)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Email (SMTP). Leave EMAIL_HOST empty to keep console backend.
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
# Comma-separated list of recipients for the contact form notifications.
# If empty, defaults to: gestion@teatrooculto.cl
CONTACT_RECIPIENTS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
